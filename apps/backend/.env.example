# Copy to backend/.env and fill in. Never commit the real .env.

# Neon connection string (Neon console > Connect). The pooled (-pooler) endpoint is fine.
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# At least 32 characters. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(64))"
JWT_SECRET=change-me-to-a-long-random-string-of-64-characters

JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=2

# JSON list of the frontend origins allowed to call the API
CORS_ORIGINS=["http://localhost:3000"]

# The refresh token lives in an httpOnly cookie. Keep COOKIE_SECURE=true (browsers accept it on
# http://localhost). COOKIE_SAMESITE=lax works while the frontend and API share a site (localhost, or
# app.example.com + api.example.com).
COOKIE_SECURE=true
COOKIE_SAMESITE=lax

# Sign-in rate limiting: failed attempts allowed per email and per IP within the lockout window
SIGNIN_MAX_FAILURES_PER_EMAIL=5
SIGNIN_MAX_FAILURES_PER_IP=20
SIGNIN_LOCKOUT_MINUTES=15

# Google and GitHub sign-in (optional: each endpoint answers 503 until its three values are set).
# The redirect URI is the frontend page the provider sends the user back to; register the exact same
# URL in the provider's console. Google: console.cloud.google.com > APIs & Services > Credentials.
# GitHub: github.com/settings/developers > OAuth Apps (ask for the user:email scope).
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/callback/google
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_REDIRECT_URI=http://localhost:3000/auth/callback/github

# Gemini (Google's official Gen AI SDK). Get a key at aistudio.google.com > Get API key.
# /eval/query answers 503 until GEMINI_API_KEY is set.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
GEMINI_TIMEOUT_SECONDS=60
