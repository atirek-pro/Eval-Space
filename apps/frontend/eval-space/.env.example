# Copy to .env.local. Where the FastAPI backend runs (apps/backend). Baked in at build time.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Google and GitHub sign-in: the public client ids only (the secrets stay in the backend's .env).
# Register http://localhost:3000/auth/callback/google and .../github as the redirect URLs.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=
NEXT_PUBLIC_GITHUB_CLIENT_ID=
